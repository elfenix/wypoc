# Minimal terminal primitives for building TUIs, over the __term_*
# natives the interpreter exposes (wypoc: wypoc/wyrm_term.py) plus a
# handful of pure-ANSI helpers that need no native support at all - just
# __write/__STDOUT, already available everywhere (see wyrm_io.py).
#
# A typical TUI's main loop:
#
#   term::raw_enable()
#   term::alt_screen_enable()
#   term::hide_cursor()
#   defer:
#       term::show_cursor()
#       term::alt_screen_disable()
#       term::raw_disable()
#   while true:
#       key := term::read_key(-1)
#       ...
#
# read_key()/size()/raw_enable()/raw_disable() are the only things that
# actually need native support (terminal I/O and mode); everything else
# below is just an escape sequence wyrm source can build itself.

fn isatty() -> int:
    return __term_isatty()

fn raw_enable():
    return __term_raw_enable()

fn raw_disable():
    return __term_raw_disable()

fn size():
    return __term_size()

# `read_key(timeout)` -> the next byte typed, as its integer codepoint, or
# -1 if `timeout` seconds pass first (or immediately, once, at end of
# input). A negative timeout blocks indefinitely.
fn read_key(timeout):
    return __term_read_key(timeout)

fn clear_screen():
    __write(__STDOUT, "\x1b[2J")
    pass

fn cursor_home():
    __write(__STDOUT, "\x1b[H")
    pass

# 1-based, matching every real terminal's own convention (row 1, col 1 is
# the top-left cell).
fn move_cursor(row, col):
    __write(__STDOUT, "\x1b[" + str(row) + ";" + str(col) + "H")
    pass

fn hide_cursor():
    __write(__STDOUT, "\x1b[?25l")
    pass

fn show_cursor():
    __write(__STDOUT, "\x1b[?25h")
    pass

# The "alternate screen buffer": what a full-screen terminal app (vim,
# less, ...) draws into, so its output doesn't scroll into - or get left
# behind in - the user's normal scrollback once it exits.
fn alt_screen_enable():
    __write(__STDOUT, "\x1b[?1049h")
    pass

fn alt_screen_disable():
    __write(__STDOUT, "\x1b[?1049l")
    pass
