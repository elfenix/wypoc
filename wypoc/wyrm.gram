@subheader """
from wypoc.actions import fold_left, make_tuple, fold_postfix, fold_index_target
from wypoc.ast_nodes import (
    Program, Pass, ExprStmt, Return, Yield, ElifClause, If, While, For,
    Continue, Break, NameTarget,
    AttrTarget, Assign, TypeHint, StaticDecl, TypeExpr, WithSimple,
    WithBinding, WithBlock, Import, FromImport, Using, Param,
    VarPositional, VarKeyword, FnDef, CoDef, ClassDef, SlotOption, SlotDef,
    Num, Str, Char, Bool, Symbol, Name, ThisRef, SuperCall, Defined,
    Lambda, Array, Pair, Tuple, DictEntry, Dict, MessageTupleExpr,
    Kwarg, SpreadPos, SpreadKw, UnaryOp, BinOp, SetIfUnset, Call, Index,
    Attr, Message, Scope, Defer, Try, Catch, TypeCheck,
)
"""

# ===========================================================================
# Wyrm grammar, PEG form (pegen), derived from doc/grammar.ebnf.
#
# Status: doc/grammar.ebnf is the intended production grammar; this file
# (plus wyrm_tokenizer.py) is a proof-of-concept implementation bootstrapping
# toward it, not a byte-for-byte transcription. The two are allowed to
# diverge on tokenizer-level edge cases (e.g. indentation/brace handling)
# as long as the annotated samples under wypoc/samples/ (test/test_grammar.py)
# keep parsing as intended - that's the compatibility bar, not line-for-line
# equivalence with the EBNF.
#
# Notes on deviations from the EBNF (see doc/grammar.ebnf's own header for
# the "INFERRED" convention this follows):
#
#  * `expression` (tuple_expr) is only used at true statement-level spots
#    (expr_stmt, return/yield operand, if/elif condition). Everywhere the
#    EBNF nests expression inside an explicit comma-delimited construct
#    (call args, array/dict elements, parens, assignment RHS) this grammar
#    uses `assign_expr` / `expr_list` directly, so that e.g. `f(1, 2)` is
#    two arguments rather than one 2-tuple argument. The literal EBNF is
#    ambiguous on this point (expr_list is itself built from `expression`,
#    which can already swallow commas via tuple_expr).
#  * `target` (assignment LHS) restricts attr_ref to a plain
#    `NAME ("." NAME)+` chain rather than a full postfix_expr, to avoid the
#    postfix chain and the separate attr_ref rule fighting over the same
#    "." tokens.
#  * elif/else on `if`, like the EBNF itself, are INFERRED (not shown
#    verbatim in the spec prose).
#  * `catch`'s handler accepts `return EXPR` or a plain `or_expr`; `try` and
#    `catch` are composable (`try EXPR catch HANDLER`) though the spec only
#    shows them separately. Both are INFERRED shapes - the spec's prose and
#    its one `catch return 0` example are the only constraints given.
#  * `on` / `error` in `defer on error` are soft keywords (double-quoted),
#    not reserved words, so plain identifiers like a slot named `on` are
#    unaffected.
# ===========================================================================

start[object]: p=program ENDMARKER { p }

program[object]: stmts=stmt_item* NEWLINE* { Program([s for group in stmts for s in group]) }

# ---------------------------------------------------------------------
# Blocks and statements
#
# Mirrors CPython's own grammar idiom: a compound_stmt's block already ends
# in its own DEDENT/"}"  with no trailing separator token to consume, while
# one or more simple_stmts sharing a physical line are ";"-separated and the
# line itself is terminated by a NEWLINE (which our tokenizer also uses for
# a literal ";" acting as a bare separator, per doc/grammar.ebnf's stmt_sep).
# ---------------------------------------------------------------------

block[object]:
    | ":" NEWLINE INDENT stmts=stmt_item* DEDENT { [s for group in stmts for s in group] }
    | ":" stmts=simple_stmt_line { stmts }
    | "{" NEWLINE* stmts=brace_stmt_item* "}" { [s for group in stmts for s in group] }

stmt_item[object]:
    | s=compound_stmt NEWLINE? { [s] }
    | simple_stmt_line

# Inside a brace-delimited block the layout rule is suppressed (see
# wyrm_tokenizer's brace_depth handling), so real newlines and ";" both
# surface as plain NEWLINE-type separators; tolerate runs of them between
# members rather than requiring exactly one.
brace_stmt_item[object]:
    | s=compound_stmt NEWLINE* { [s] }
    | first=simple_stmt NEWLINE+ { [first] }
    | first=simple_stmt { [first] }

simple_stmt_line[object]:
    | first=simple_stmt ";" rest=simple_stmt_line { [first] + rest }
    | first=simple_stmt ";" NEWLINE { [first] }
    | first=simple_stmt ";" { [first] }
    | first=simple_stmt NEWLINE { [first] }
    | first=simple_stmt { [first] }

simple_stmt[object]:
    | with_stmt_simple
    | static_stmt
    | assignment_stmt
    | type_hint_stmt
    | from_import_stmt
    | import_stmt
    | using_stmt
    | return_stmt
    | yield_stmt
    | pass_stmt
    | continue_stmt
    | break_stmt
    | expr_stmt

compound_stmt[object]:
    | if_stmt
    | while_stmt
    | for_stmt
    | fn_def
    | co_def
    | class_def
    | with_block
    | defer_stmt

pass_stmt[object]: 'pass' { Pass() }
continue_stmt[object]: 'continue' { Continue() }
break_stmt[object]: 'break' { Break() }

expr_stmt[object]: e=expression { ExprStmt(e) }

return_stmt[object]:
    | 'return' e=expression { Return(e) }
    | 'return' { Return(None) }

yield_stmt[object]:
    | 'yield' 'from' e=expression { Yield(e, True) }
    | 'yield' e=expression { Yield(e) }
    | 'yield' { Yield(None) }

# ---- if statement ------------------------------------------------------

if_stmt[object]:
    | 'if' cond=expression body=block elifs=elif_clause* orelse=else_clause? {
          If(cond, body, elifs, orelse) }

elif_clause[object]:
    | 'elif' cond=expression body=block { ElifClause(cond, body) }

else_clause[object]:
    | 'else' body=block { body }

# ---- while / for statements ---------------------------------------------
# `for`'s `else` runs only if the loop completes without `break`, matching
# Python's for/else (see doc/language-spec.md's Control Flow section).

while_stmt[object]:
    | 'while' cond=expression body=block { While(cond, body) }

for_stmt[object]:
    | 'for' n=NAME 'in' it=expression body=block orelse=else_clause? { For(n.string, it, body, orelse) }

# ---- defer statement ------------------------------------------------------
# `on`/`error` are soft keywords (double-quoted below) rather than reserved
# words, so e.g. `slot on: bool` (see wypoc/samples/compile_class_def.wy)
# keeps working - only literal `defer on error` triggers this form.

defer_stmt[object]:
    | 'defer' "on" "error" body=block { Defer(True, body) }
    | 'defer' body=block { Defer(False, body) }

# ---- assignment / bindings ---------------------------------------------

assignment_stmt[object]:
    | targets=target_list ty=(":" ann_type)? op=assign_op vals=expr_list {
          Assign(targets, ty[1] if ty else None, op, vals) }

target_list[object]:
    | first=target rest=("," target)* { [first] + [t for _, t in rest] }

# A target may carry trailing `[expr]` suffixes (`arr[i] = x`,
# `grid[i][j] = x`, `this.cells[i] = x`), each wrapping the previous
# target in an IndexTarget - see fold_index_target (wypoc/actions.py) and
# assign_target's IndexTarget case (mutates the underlying array/dict in
# place via Python's own __setitem__, since that's what arrays/dicts
# already are in this POC evaluator).
target[object]:
    | base=target_base idxs=target_index_suffix* { fold_index_target(base, idxs) }

target_base[object]:
    | 'this' rest=("." NAME)+ { AttrTarget(ThisRef(), [a.string for _, a in rest]) }
    | n=NAME rest=("." NAME)+ { AttrTarget(n.string, [a.string for _, a in rest]) }
    | NAME { NameTarget(name.string) }

target_index_suffix[object]:
    | "[" e=expression "]" { e }

assign_op[object]:
    | "?=" { '?=' }
    | "=" { '=' }

type_hint_stmt[object]:
    | n=NAME ":" t=ann_type { TypeHint(n.string, t) }

# `static` declares a binding tied to the enclosing fn/class definition
# rather than the current call/instance (see doc/language-spec.md's
# "Variables" section). After declaration the name is an ordinary target -
# no special sigil needed at use sites, just NameTarget like any local.
static_stmt[object]:
    | 'static' n=NAME ty=(":" ann_type)? dflt=("=" assign_expr)? {
          StaticDecl(n.string, ty[1] if ty else None, dflt[1] if dflt else None) }

type_expr[object]:
    | first=NAME rest=("::" NAME)* { TypeExpr([first.string] + [n.string for _, n in rest]) }

# An annotation position (return type, param/slot/variable type, coroutine
# input type, ...) accepts a `|`-unioned type per doc/language-spec.md
# ("Type constraints may represent summation types as well", used
# throughout the spec's prose as e.g. `-> int | error`). This POC doesn't
# model types at runtime beyond a couple of decorative checks (see
# wyrm_eval_parse_tree.py's _zero_value/_matches_type and
# compiler_c/wtypes.ctype), so a union annotation parses fully but keeps
# only its first arm - good enough to accept the spec's own examples
# without needing every annotation field to become a list.
ann_type[object]:
    | first=type_expr ("|" type_expr)* { first }

# ---- immutable bindings --------------------------------------------------

with_stmt_simple[object]:
    | 'with' n=NAME ty=(":" ann_type)? "=" e=assign_expr {
          WithSimple(n.string, ty[1] if ty else None, e) }

with_block[object]:
    | 'with' ":" NEWLINE INDENT bindings=with_binding_list DEDENT { WithBlock(bindings) }

with_binding_list[object]:
    | first=with_binding NEWLINE rest=with_binding_list { [first] + rest }
    | first=with_binding NEWLINE { [first] }
    | first=with_binding { [first] }

with_binding[object]:
    | n=NAME ty=(":" ann_type)? "=" e=assign_expr { WithBinding(n.string, ty[1] if ty else None, e) }

# ---------------------------------------------------------------------
# Modules and imports
# ---------------------------------------------------------------------

import_stmt[object]:
    | 'import' m=module_path { Import(m) }

module_path[object]:
    | first=NAME rest=("::" NAME)* { [first.string] + [n.string for _, n in rest] }

from_import_stmt[object]:
    | 'from' m=module_path 'import' names=name_list { FromImport(m, names) }

name_list[object]:
    | first=NAME rest=("," NAME)* { [first.string] + [n.string for _, n in rest] }

# `module_path` is greedily "::"-segmented, so it can't be split back into a
# "module path" + trailing "::ident" by sequencing alone (the EBNF's
# `using module_path "::" identifier` form is ambiguous against plain
# `using module_path` for that reason). Both collapse to one path here;
# whether the last segment names a module or a single symbol is a binding
# question for a later pass, not something syntax can decide. (INFERRED)
using_stmt[object]:
    | 'using' alias=NAME "=" m=module_path { Using(m, alias.string) }
    | 'using' m=module_path { Using(m) }

# ---------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------

fn_def[object]:
    | 'fn' cls=class_target n=NAME "(" params=param_list? ")" ret=("->" ann_type)? body=block {
          FnDef(cls, n.string, params or [], ret[1] if ret else None, body) }
    | 'fn' n=NAME "(" params=param_list? ")" ret=("->" ann_type)? body=block {
          FnDef(None, n.string, params or [], ret[1] if ret else None, body) }

class_target[object]:
    | "[" first=NAME rest=("," NAME)* "]" { [first.string] + [n.string for _, n in rest] }

param_list[object]:
    | first=param rest=("," param)* { [first] + [p for _, p in rest] }

param[object]:
    | var_positional
    | var_keyword
    | plain_param

plain_param[object]:
    | n=NAME ty=(":" ann_type)? dflt=("=" assign_expr)? {
          Param(n.string, ty[1] if ty else None, dflt[1] if dflt else None) }

var_positional[object]: "*" n=NAME { VarPositional(n.string) }
var_keyword[object]: "**" n=NAME { VarKeyword(n.string) }

# ---------------------------------------------------------------------
# Coroutines
# ---------------------------------------------------------------------

# The coroutine input type, if given, is a leading marker inside the
# parameter list rather than a trailing arrow after the parens - e.g.
# `co f(<- str, x: int, y: int) -> int:`. It isn't itself a bindable
# parameter (no name, never supplied by the caller), only the type of
# whatever value is sent in through each `yield` expression. This is a
# separate rule from `param`/`param_list` (used by `fn_def` too) so `<-`
# never becomes legal in a plain function's parameter list.
co_params[object]:
    | "<-" t=ann_type "," p=param_list { (t, p) }
    | "<-" t=ann_type { (t, []) }
    | p=param_list { (None, p) }

co_def[object]:
    | 'co' cls=class_target n=NAME "(" cp=co_params? ")" ret=("->" ann_type)? body=block {
          CoDef(cls, n.string, cp[1] if cp else [], cp[0] if cp else None, ret[1] if ret else None, body) }
    | 'co' n=NAME "(" cp=co_params? ")" ret=("->" ann_type)? body=block {
          CoDef(None, n.string, cp[1] if cp else [], cp[0] if cp else None, ret[1] if ret else None, body) }

# ---------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------

# class_block's action wraps its member list in a 1-tuple (never falsy,
# even for an empty class body like `class Foo(error) {}`) rather than
# returning the bare list directly - pegen's generated code truthiness-
# checks a required (non-*, non-?) sub-rule capture, and `*`/`?` captures
# get an automatic trailing-comma wrap that plain rule references don't,
# so a genuinely empty member list would otherwise make class_def's whole
# alternative look like a failed match. class_def unwraps with body[0].
class_def[object]:
    | 'class' n=NAME "(" bases=arg_list? ")" body=class_block { ClassDef(n.string, bases or [], body[0]) }
    | 'class' n=NAME body=class_block { ClassDef(n.string, [], body[0]) }

class_block[object]:
    | ":" NEWLINE INDENT members=class_member_item* DEDENT { (members,) }
    | "{" NEWLINE* members=class_member_brace* "}" { (members,) }

class_member_brace[object]:
    | m=fn_def NEWLINE* { m }
    | m=co_def NEWLINE* { m }
    | m=slot_def NEWLINE* { m }
    | m=static_stmt NEWLINE* { m }

class_member_item[object]:
    | m=fn_def NEWLINE? { m }
    | m=co_def NEWLINE? { m }
    | m=slot_def NEWLINE { m }
    | m=slot_def { m }
    | m=static_stmt NEWLINE? { m }

slot_def[object]:
    | 'slot' n=NAME ty=(":" ann_type)? dflt=("=" assign_expr)? opts=('with' slot_options)? {
          SlotDef(n.string, ty[1] if ty else None, dflt[1] if dflt else None, opts[1] if opts else None) }

slot_options[object]:
    | ":" NEWLINE INDENT opts=slot_option_list DEDENT { opts }
    | "{" opts=slot_option_brace* "}" { opts }

slot_option_brace[object]:
    | o=slot_option ";"? { o }

slot_option_list[object]:
    | first=slot_option NEWLINE rest=slot_option_list { [first] + rest }
    | first=slot_option NEWLINE { [first] }
    | first=slot_option { [first] }

slot_option[object]:
    | kind=('setter' | 'getter') "=" 'undefined' { SlotOption(kind.string, 'undefined') }
    | kind=('setter' | 'getter') "=" e=assign_expr { SlotOption(kind.string, e) }

# No dedicated constructor syntax: `init` is just an ordinary fn_def member
# (`fn init(...): ...`), promoted to the class's constructor by name alone -
# see doc/language-spec.md's "Basic Classes" section. `init` is no longer a
# reserved word (see wyrm_tokenizer.py), so this needs no grammar of its own.

# ---------------------------------------------------------------------
# Expressions
# ---------------------------------------------------------------------

expression[object]:
    | items=expr_list { items[0] if len(items) == 1 else Tuple(items) }

expr_list[object]:
    | first=assign_expr rest=("," assign_expr)* { [first] + [e for _, e in rest] }

assign_expr[object]:
    | 'yield' 'from' e=expression { Yield(e, True) }
    | 'yield' e=expression { Yield(e) }
    | 'yield' { Yield(None) }
    | a=or_expr "?=" b=or_expr { SetIfUnset(a, b) }
    | catch_expr

# ---- try / catch ---------------------------------------------------------
# `try EXPR` returns immediately from the enclosing function if EXPR's value
# is an error; `EXPR catch HANDLER` substitutes HANDLER's value instead
# (HANDLER may itself be `return EXPR`). The two compose: `try EXPR catch ...`.

catch_expr[object]:
    | v=try_operand 'catch' h=catch_handler { Catch(v, h) }
    | try_operand

try_operand[object]:
    | 'try' e=or_expr { Try(e) }
    | or_expr

catch_handler[object]:
    | 'return' e=expression { Return(e) }
    | 'return' { Return(None) }
    | or_expr

or_expr[object]:
    | first=and_expr rest=('or' and_expr)* { fold_left(first, [('or', e) for _, e in rest]) }

and_expr[object]:
    | first=not_expr rest=('and' not_expr)* { fold_left(first, [('and', e) for _, e in rest]) }

not_expr[object]:
    | 'not' e=not_expr { UnaryOp('not', e) }
    | comparison

comparison[object]:
    | a=bitwise_or_expr 'is' t=type_constraint { TypeCheck(a, t) }
    | a=bitwise_or_expr op=comp_op b=bitwise_or_expr { BinOp(op, a, b) }
    | bitwise_or_expr

comp_op[object]:
    | "<=" ">" { '<=>' }
    | "<=" { '<=' }
    | ">=" { '>=' }
    | "==" { '==' }
    | "!=" { '!=' }
    | "<" { '<' }
    | ">" { '>' }
    | 'in' { 'in' }

# Type constraint: a union of type names, e.g. `int` or `int | float`.
type_constraint[object]:
    | first=type_expr rest=("|" type_expr)* { [first] + [t for _, t in rest] }

bitwise_or_expr[object]:
    | first=bitwise_xor_expr rest=("|" bitwise_xor_expr)* { fold_left(first, [('|', e) for _, e in rest]) }

bitwise_xor_expr[object]:
    | first=bitwise_and_expr rest=("^" bitwise_and_expr)* { fold_left(first, [('^', e) for _, e in rest]) }

bitwise_and_expr[object]:
    | first=additive_expr rest=("&" additive_expr)* { fold_left(first, [('&', e) for _, e in rest]) }

additive_expr[object]:
    | first=mult_expr rest=(("+" | "-") mult_expr)* { fold_left(first, [(op.string, e) for op, e in rest]) }

mult_expr[object]:
    | first=unary_expr rest=(("*" | "/" | "%") unary_expr)* { fold_left(first, [(op.string, e) for op, e in rest]) }

unary_expr[object]:
    | "-" e=unary_expr { UnaryOp('neg', e) }
    | 'not' e=unary_expr { UnaryOp('not', e) }
    | power_expr

power_expr[object]:
    | base=postfix_expr "**" exp=unary_expr { BinOp('**', base, exp) }
    | postfix_expr

postfix_expr[object]:
    | first=primary ops=postfix_op* { fold_postfix(first, ops) }

postfix_op[object]:
    | call_op
    | index_op
    | attr_op
    | message_op
    | scope_op

call_op[object]:
    | "(" args=arg_list? ")" { (lambda node, a=(args or []): Call(node, a)) }

index_op[object]:
    | "[" e=expression "]" { (lambda node, e=e: Index(node, e)) }

attr_op[object]:
    | "." n=NAME { (lambda node, name=n.string: Attr(node, name)) }

message_op[object]:
    | "!" n=NAME "(" args=arg_list? ")" { (lambda node, name=n.string, a=(args or []): Message(node, name, a)) }
    | "!" n=NAME { (lambda node, name=n.string: Message(node, name, None)) }

scope_op[object]:
    | "::" n=NAME { (lambda node, name=n.string: Scope(node, name)) }

arg_list[object]:
    | first=argument rest=("," argument)* { [first] + [a for _, a in rest] }

argument[object]:
    | n=NAME "=" e=assign_expr { Kwarg(n.string, e) }
    | "**" e=assign_expr { SpreadKw(e) }
    | "*" e=assign_expr { SpreadPos(e) }
    | e=assign_expr { e }

primary[object]:
    | literal
    | message_tuple_expr
    | paren_or_tuple
    | array_literal
    | pair_literal
    | dict_literal
    | 'this' { ThisRef() }
    | 'super' "(" args=arg_list? ")" { SuperCall(args or []) }
    | 'defined' "(" s=symbol_literal ")" { Defined(s) }
    | lambda_expr
    | NAME { Name(name.string) }

literal[object]:
    | NUMBER { Num(number.string) }
    # A char literal (\a, \newline, ...) and a plain string share the STRING
    # wire type (see wyrm_tokenizer.py's _scan_char) and are told apart here
    # by their leading character.
    | STRING { Char(string.string) if string.string[0] == '\\' else Str(string.string) }
    | 'true' { Bool(True) }
    | 'false' { Bool(False) }
    | symbol_literal

symbol_literal[object]:
    | "'" n=NAME { Symbol(n.string) }

# ---- collection literals ------------------------------------------------

array_literal[object]:
    | "$" "[" items=expr_list? "]" { Array(items or []) }

# Pair / list: [a] single pair, [1, 2, 3] list of pairs,
# [1, 2, 3, $. 6] improper list.
pair_literal[object]:
    | "[" body=pair_body? "]" { Pair(body[0], body[1]) if body else Pair([], None) }

pair_body[object]:
    | first=assign_expr rest=("," assign_expr)* tail=("," "$" "." assign_expr)? {
          ([first] + [e for _, e in rest], tail[3] if tail else None) }
    | "$" "." e=assign_expr { ([], e) }

paren_or_tuple[object]:
    | "(" ")" { Tuple([]) }
    | "(" first=assign_expr "," ")" { make_tuple(first, [], ",") }
    | "(" first=assign_expr rest=("," assign_expr)+ trailing=","? ")" {
          make_tuple(first, [e for _, e in rest], trailing) }
    | "(" e=assign_expr ")" { e }

dict_literal[object]:
    | "$" "{" body=dict_body? "}" { Dict(body or []) }

dict_body[object]:
    | first=dict_pair rest=("," dict_pair)* { [first] + [p for _, p in rest] }

dict_pair[object]:
    | k=assign_expr ":" v=assign_expr { DictEntry(k, v) }

# (canvas, shape) ! draw();  -- message dispatch against a tuple
message_tuple_expr[object]:
    | "(" items=expr_list ")" "!" n=NAME "(" args=arg_list? ")" {
          MessageTupleExpr(items, n.string, args or []) }
    | "(" items=expr_list ")" "!" n=NAME {
          MessageTupleExpr(items, n.string, None) }

lambda_expr[object]:
    | 'fn' "(" params=param_list? ")" body=block { Lambda(params or [], body) }
