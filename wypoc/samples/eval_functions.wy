fn add(a, b):
    return a + b

fn greet(name, greeting = "Hello"):
    return greeting + ", " + name

fn classify(n):
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    else:
        return "positive"

fn pack(*nums):
    return nums

sum_direct := add(2, 3)
greeting_default := greet("Wyrm")
greeting_custom := greet("Wyrm", "Hey")
classify_neg := classify(-5)
classify_zero := classify(0)
classify_pos := classify(7)
packed := pack(1, 2, 3)

adder := fn (a, b):
    return a + b
lambda_result := adder(4, 5)

fn call_count():
    static count: int = 0
    count = count + 1
    return count

call_count_1 := call_count()
call_count_2 := call_count()
call_count_3 := call_count()

fn call_count_declared():
    static count: int
    count ?= 0
    count = count + 1
    return count

call_count_declared_1 := call_count_declared()
call_count_declared_2 := call_count_declared()
