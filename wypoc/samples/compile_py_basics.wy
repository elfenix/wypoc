fn clamp(x: int, lo: int, hi: int) -> int:
    var result: int = x
    if result < lo:
        result = lo
    elif result > hi:
        result = hi
    return result

fn count_up_to(n: int) -> int:
    var i: int = 0
    var total: int = 0
    while i < n:
        total = total + i
        i = i + 1
    return total

var clamped: int = clamp(15, 0, 10)
var summed: int = count_up_to(5)
print("clamped=", clamped, " summed=", summed)
