fn returns_via_try() -> error:
    try error("Hello World")
    return "unreachable"

try_result = returns_via_try()

fn try_passthrough(x):
    y = try x
    return y + 1

passthrough_result = try_passthrough(10)

f = error("Hello") catch 5

not_an_error = 10 catch 5

fn returns_via_catch_return():
    value = error("boom") catch return 0
    return value

catch_return_result = returns_via_catch_return()
