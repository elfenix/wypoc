import std::io

fn partial_add(end: int) -> int:
    fn mod_partial(val: int) -> str:
        return "Modified '" + str(val) + "'"
    for i in range(0, end):
        std::io::println(mod_partial(i))

fn make_closure(val: int):
    fn addend(s: int) -> int:
        return s + val
    return addend

sfn := make_closure(10)

partial_add(5)

std::io::println("?" + str(sfn(5)))

    