# Floats compile now: the interpreter this targets has a dedicated float tag
# and payload field, which is what the previous backend was missing. Mixed
# arithmetic widens to float; `%` and the bitwise operators have no float
# form in C and are refused rather than mis-compiled (see compile_err_*).
import native

fn scale(a: float, b: float) -> float:
    return a * b

fn widen(a: int, b: float) -> float:
    return a + b

fn area(r: float) -> float:
    var t: float = r * r
    return scale(t, 3.14159)

fn is_small(x: float) -> bool:
    return x < 1.0
