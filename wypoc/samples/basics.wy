import mod::baz::bar

from mod import function

using math
using math::sin
using sin = math::sin

foo: int = 5
foo, bar = 5, 4
foo: int
foo ?= 5
foo_with_type: int ?= 5

with speed_of_light: float = 299_792_458.0

with:
    speed_of_light: float = 299_792_458.0
    gravitational_constant = 6.6743e-11

