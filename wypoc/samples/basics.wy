co simple():
    yield 1

co count_to_5() -> int:
    yield 1
    yield 2
    yield 3
    yield 4
    yield 5

co mirror_5x() -> float:
    a = yield 0
    a = yield a
    a = yield a
    a = yield a
    a = yield a
    yield a

co div2_1x(<- int) -> float:
    a = yield 0
    yield a / 2.0
