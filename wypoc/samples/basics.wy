import mod
import mod::baz::bar

from mod import function

import math::*
import math::sin
import math::sin as sin

var foo: int = 5      # canonical declaration with type constraint
var foo2 = 5           # inferred type
foo3 := 5               # shorthand for `var foo3 = 5`

foo4, bar := 5, 4        # multi-declare, inferred types

var forward: int          # forward declaration; forward is Unset until assigned
forward ?= 5

var foo_with_type: int
foo_with_type ?= 5

with speed_of_light: float = 299_792_458.0

with:
    speed_of_light: float = 299_792_458.0
    gravitational_constant = 6.6743e-11

if foo:
    action()
another_action()

if foo { action(); } another_action();

if defined('foo):
    foo = foo + 1
else:
    foo = 1

fn hello():
    pass

fn message() -> str:
    return "Hello World"

fn message(name) -> str:
    return "Hello " + name

fn message(*arguments) -> str:
    greeting, name := arguments
    return greeting + name

fn message(name: str, greeting: str = "Hello") -> str:
    return greeting + name

fn message(**kwargs) -> str:
    return kwargs["greeting"] + kwargs["name"]

fn call_count():
    static foo: int = 0
    foo = foo + 1
    return foo

fn call_count_2():
    static foo: int
    foo ?= 0
    foo = foo + 1
    return foo

message_spread := message(*t1)
message_spread_kw := message(**d)
message_spread_combo := message(1, *t1, **d)

arr_len := array_object!length()

x := [1, 2, 3, 4]         # list/array

y := $[1, 2, 3, 4, 5]      # proper pair list
z := pair('a, 'b)           # improper pair, SCHEME '(a . b)

t1 := 1, 2, 3, 4
t2 := (1,)
t3 := ()

d := { "Name": 15 }
d2 := {}

a := a ** 2
b := a + b + c
c := a * b * c
e := a - b - c
f := a % b % c
g := a / b / c

h := a & b
i := a | b
j := a ^ b
j1 := a << b
j2 := a >> b
j3 := ~a
j4 := +a
j5 := a & b << c        # shifts bind tighter than `&`, looser than `+`

# `$` is an identifier character, anywhere in a name
reg$0 := a
sum$total := reg$0 + b

k := a or b
l := a and b
m := not a

n1 := a <= b
n2 := a >= b
n3 := a <=> b
n4 := a < b
n5 := b > b
n6 := a == b
n7 := a != b
n8 := a is int
n9 := a is not int
n10 := a is not int | float

co simple():
    yield 1

co count_to_5() -> int:
    yield 1
    yield 2
    yield 3
    yield 4
    yield 5

co mirror_5x() -> float:
    a := yield 0
    a = yield a
    a = yield a
    a = yield a
    a = yield a
    yield a

co div2_1x(<- int) -> float:
    a := yield 0
    yield a / 2.0
