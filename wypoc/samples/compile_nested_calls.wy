# A call is an ordinary C call now, so it may appear anywhere in an
# expression - the previous backend could only place one as a whole statement
# or a bare `return`, because a call there had to split its enclosing block.
import native

fn inc(a: int) -> int:
    return a + 1

fn add(a: int, b: int) -> int:
    return a + b

fn nested(x: int) -> int:
    return add(inc(x), inc(inc(x))) + 1

fn in_a_condition(x: int) -> int:
    if inc(x) > 3:
        return add(x, inc(x))
    return 0

fn in_a_loop_condition(n: int) -> int:
    var total: int = 0
    while inc(total) < n:
        total = add(total, 2)
    return total

# `and`/`or` short-circuit, so a call on the right must not run when the left
# already decided - the lowering rebuilds the branch rather than using `&&`.
fn short_circuit(x: int) -> bool:
    return x > 0 and inc(x) > 2
