# A --compile-py-scoped subset of samples/eval_error_handling.wy: everything
# except `class DetectedHardwareFailure(error) {}` and its usage, which
# would need this backend to support inheriting a user class from the
# builtin `error` type - not yet implemented (see classes.py's single-
# inheritance-among-user-classes-only assumption).

fn returns_via_try() -> error:
    try error("Hello World")
    return "unreachable"

try_result := returns_via_try()

fn try_passthrough(x):
    y := try x
    return y + 1

passthrough_result := try_passthrough(10)

f := error("Hello") catch 5

not_an_error := 10 catch 5

fn returns_via_catch_return():
    value := error("boom") catch return 0
    return value

catch_return_result := returns_via_catch_return()

class demo:
    slot result: int

    fn init(num: int, den: int):
        this.result = try num / den

demo_ok := demo(10, 2) catch 'div0
demo_div_by_zero := demo(10, 0) catch 'div0

out_of_range_list := [1, 2]
index_error_result := out_of_range_list[12] catch 0
