import native

fn clamp(x: int, lo: int, hi: int) -> int:
    result: int = x
    if result < lo:
        result = lo
    elif result > hi:
        result = hi
    return result

fn count_up_to(n: int) -> int:
    i: int = 0
    total: int = 0
    while i < n:
        total = total + i
        i = i + 1
    return total
