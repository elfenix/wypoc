{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wyrm",
  "scopeName": "source.wyrm",
  "fileTypes": ["wy", "wyrm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#symbols" },
    { "include": "#constants" },
    { "include": "#class-decl" },
    { "include": "#function-decl" },
    { "include": "#coroutine-decl" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#builtin-functions" },
    { "include": "#builtin-types" },
    { "include": "#pair-list-sigil" },
    { "include": "#message-op" },
    { "include": "#scope-op" },
    { "include": "#attribute-access" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.wyrm",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.wyrm" }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "triple-quoted string: opens with three quotes, closes with two (see doc/grammar.ebnf, multiline_string)",
          "name": "string.quoted.triple.wyrm",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.wyrm" }
          },
          "end": "\"\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.wyrm" }
          },
          "patterns": [
            { "name": "constant.character.escape.wyrm", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.raw.wyrm",
          "begin": "R\"([A-Za-z0-9_]*)\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.wyrm" },
            "1": { "name": "punctuation.definition.string.raw.tag.wyrm" }
          },
          "end": "\\)\\1\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.wyrm" }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.double.wyrm",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.wyrm" }
          },
          "end": "\"|(?<!\\\\)$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.wyrm" }
          },
          "patterns": [
            { "name": "constant.character.escape.wyrm", "match": "\\\\." }
          ]
        }
      ]
    },
    "characters": {
      "comment": "Clojure-style char literals. Scoped under `string.` on purpose: that is what tells VS Code these are literal text, so `\\[`, `\\(` and `\\\"` neither auto-close nor register as bracket pairs.",
      "patterns": [
        {
          "comment": "named form: \\newline, \\space, ...",
          "name": "string.other.character.wyrm",
          "match": "\\\\(newline|space|tab|return|backspace|formfeed|null)\\b"
        },
        {
          "comment": "any other multi-letter name after \\ - still one token lexically, even though only the names above are valid",
          "name": "invalid.illegal.character.wyrm",
          "match": "\\\\[A-Za-z_][A-Za-z0-9_]+"
        },
        {
          "comment": "single-char form: \\a, \\5, \\(, \\\\, ...  the trailing alternative catches a lone backslash mid-edit, so the character being typed after it is already inside a string-ish token",
          "name": "string.other.character.wyrm",
          "match": "\\\\.|\\\\"
        }
      ]
    },
    "numbers": {
      "comment": "A leading '-' is the arithmetic operator, not part of the literal - matching it here would swallow the minus in `a-1`.",
      "patterns": [
        {
          "name": "constant.numeric.hex.wyrm",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.float.wyrm",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.wyrm",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.wyrm",
          "match": "(')[A-Za-z_][A-Za-z0-9_]*",
          "captures": {
            "1": { "name": "punctuation.definition.symbol.wyrm" }
          }
        }
      ]
    },
    "constants": {
      "comment": "literal values - kept in one family so themes render them uniformly",
      "patterns": [
        {
          "name": "constant.language.boolean.wyrm",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.wyrm",
          "match": "\\bnil\\b"
        },
        {
          "name": "constant.language.undefined.wyrm",
          "match": "\\bundefined\\b"
        },
        {
          "name": "variable.language.this.wyrm",
          "match": "\\bthis\\b"
        },
        {
          "name": "variable.language.super.wyrm",
          "match": "\\bsuper\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.wyrm",
          "match": "\\b(if|elif|else)\\b"
        },
        {
          "name": "keyword.control.loop.wyrm",
          "match": "\\b(for|while|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.wyrm",
          "match": "\\b(return|yield|pass)\\b"
        },
        {
          "name": "keyword.control.exception.wyrm",
          "match": "\\b(try|catch|defer)\\b"
        },
        {
          "comment": "soft keywords, only meaningful right after 'defer' - see defer_stmt",
          "name": "keyword.control.exception.wyrm",
          "match": "(?<=\\bdefer\\s)(on\\s+error)\\b"
        },
        {
          "name": "keyword.control.import.wyrm",
          "match": "\\b(import|from|as|except)\\b"
        },
        {
          "name": "keyword.control.do.wyrm",
          "match": "\\bdo\\b"
        },
        {
          "comment": "binding forms - storage.* is the conventional family for declaration keywords",
          "name": "storage.type.var.wyrm",
          "match": "\\bvar\\b"
        },
        {
          "name": "storage.type.slot.wyrm",
          "match": "\\bslot\\b"
        },
        {
          "name": "storage.modifier.static.wyrm",
          "match": "\\bstatic\\b"
        },
        {
          "name": "storage.modifier.with.wyrm",
          "match": "\\bwith\\b"
        },
        {
          "name": "storage.type.function.wyrm",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.coroutine.wyrm",
          "match": "\\bco\\b"
        },
        {
          "name": "storage.type.class.wyrm",
          "match": "\\bclass\\b"
        },
        {
          "name": "keyword.operator.logical.wyrm",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "comment": "membership test operator, e.g. a in b - also doubles as for-loop's `in`",
          "name": "keyword.operator.in.wyrm",
          "match": "\\bin\\b"
        },
        {
          "comment": "type-check operator, e.g. a is int | float",
          "name": "keyword.operator.is.wyrm",
          "match": "\\bis\\b"
        },
        {
          "name": "keyword.other.slot-option.wyrm",
          "match": "\\b(setter|getter)\\b(?=\\s*=)"
        }
      ]
    },
    "builtin-types": {
      "comment": "fundamental type names from doc/language-spec.md's Fundamental Types. They are ordinary identifiers, not reserved words, so they get support.type rather than storage.type.",
      "patterns": [
        {
          "name": "support.type.builtin.wyrm",
          "match": "\\b(bool|int|uint|float|sym|bytes|str|tuple|list|dict|pair|array|fiber|closure|coroutine|message|object|error|file)\\b"
        },
        {
          "comment": "predefined error classes",
          "name": "support.class.builtin.wyrm",
          "match": "\\b(Unset|NotFound|OutOfMemory|StopIteration|RuntimeError|OSError)\\b"
        }
      ]
    },
    "builtin-functions": {
      "comment": "globals from wyrm_builtins.py, plus the `defined` operator. Only in call position, so `pair`/`error` still read as types when used as type constraints.",
      "patterns": [
        {
          "name": "support.function.builtin.wyrm",
          "match": "\\b(defined|print|len|copy|cons|pair|car|cdr|next|send)\\b(?=\\s*\\()"
        },
        {
          "comment": "native methods registered on builtin values",
          "match": "(\\.)\\s*(substr|remove|resize|expand|append)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.wyrm" },
            "2": { "name": "support.function.builtin.wyrm" }
          }
        }
      ]
    },
    "class-decl": {
      "patterns": [
        {
          "comment": "class Name  /  class Name(Parent)",
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)?)?",
          "captures": {
            "1": { "name": "storage.type.class.wyrm" },
            "2": { "name": "entity.name.class.wyrm" },
            "3": { "name": "punctuation.section.parens.wyrm" },
            "4": { "name": "entity.other.inherited-class.wyrm" }
          }
        }
      ]
    },
    "function-decl": {
      "patterns": [
        {
          "comment": "fn [Type, ...] name(...)  -- external method definition, one receiver type per dispatch position",
          "begin": "\\b(fn)\\s*(\\[)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.wyrm" },
            "2": { "name": "punctuation.definition.class-target.begin.wyrm" }
          },
          "end": "(\\])\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "endCaptures": {
            "1": { "name": "punctuation.definition.class-target.end.wyrm" },
            "2": { "name": "entity.name.function.wyrm" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "entity.name.class.wyrm",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.wyrm",
              "match": ","
            }
          ]
        },
        {
          "comment": "fn name(...)",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.wyrm" },
            "2": { "name": "entity.name.function.wyrm" }
          }
        },
        {
          "comment": "anonymous fn(...)  -- lambda, no name follows",
          "name": "storage.type.function.wyrm",
          "match": "\\b(fn)\\b(?=\\s*\\()"
        }
      ]
    },
    "coroutine-decl": {
      "patterns": [
        {
          "comment": "co [Type, ...] name(...)",
          "begin": "\\b(co)\\s*(\\[)",
          "beginCaptures": {
            "1": { "name": "storage.type.coroutine.wyrm" },
            "2": { "name": "punctuation.definition.class-target.begin.wyrm" }
          },
          "end": "(\\])\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "endCaptures": {
            "1": { "name": "punctuation.definition.class-target.end.wyrm" },
            "2": { "name": "entity.name.function.wyrm" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "entity.name.class.wyrm",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.wyrm",
              "match": ","
            }
          ]
        },
        {
          "comment": "co name(...)",
          "match": "\\b(co)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.coroutine.wyrm" },
            "2": { "name": "entity.name.function.wyrm" }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "comment": "@name(...) / @mod::name(...) - compile-time AST-rewriting decorator, see doc/language-spec.md's Decorators section. Only the qualified-name part is highlighted here; its call args are ordinary expressions handled by the rest of the grammar.",
          "match": "(@)\\s*((?:[A-Za-z_][A-Za-z0-9_]*\\s*(?:::)\\s*)*)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.wyrm" },
            "2": { "name": "entity.name.namespace.wyrm" },
            "3": { "name": "entity.name.function.decorator.wyrm" }
          }
        }
      ]
    },
    "pair-list-sigil": {
      "patterns": [
        {
          "comment": "$[ ... ] pair-list literal, e.g. $[1, 2, 3] or $['a] - a low-level cons-list primitive, distinct from a plain [ ... ] list/array literal",
          "name": "punctuation.definition.pair-list.wyrm",
          "match": "\\$\\["
        }
      ]
    },
    "message-op": {
      "patterns": [
        {
          "comment": "obj!method(...) message dispatch",
          "match": "(!)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.message.wyrm" },
            "2": { "name": "entity.name.function.message.wyrm" }
          }
        }
      ]
    },
    "scope-op": {
      "patterns": [
        {
          "comment": "the segment left of a `::` is a namespace, e.g. std in std::io::open",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=::)",
          "name": "entity.name.namespace.wyrm"
        },
        {
          "comment": "an interior path segment, e.g. io in std::io::open",
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*::)",
          "captures": {
            "1": { "name": "keyword.operator.scope.wyrm" },
            "2": { "name": "entity.name.namespace.wyrm" }
          }
        },
        {
          "comment": "import mod::*",
          "match": "(::)\\s*(\\*)",
          "captures": {
            "1": { "name": "keyword.operator.scope.wyrm" },
            "2": { "name": "keyword.operator.wildcard.wyrm" }
          }
        },
        {
          "comment": "mod::name(...) - a call through a namespace",
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.operator.scope.wyrm" },
            "2": { "name": "entity.name.function.call.wyrm" }
          }
        },
        {
          "comment": "mod::name - plain namespace access",
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.scope.wyrm" },
            "2": { "name": "variable.other.member.wyrm" }
          }
        },
        {
          "comment": "import mod::* ",
          "name": "keyword.operator.scope.wyrm",
          "match": "::"
        }
      ]
    },
    "attribute-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.wyrm" },
            "2": { "name": "entity.name.function.call.wyrm" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.wyrm" },
            "2": { "name": "variable.other.property.wyrm" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.wyrm"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "declaration operators - must be matched before the bare ':' (punctuation) and '=' (assignment) patterns below",
          "name": "keyword.operator.declare.wyrm",
          "match": ":=|\\?="
        },
        {
          "comment": "arrows before the comparison operators, which would otherwise claim the '<' of '<-'",
          "name": "keyword.operator.arrow.wyrm",
          "match": "->|<-"
        },
        {
          "name": "keyword.operator.comparison.wyrm",
          "match": "<=>|==|!=|<=|>=|<|>"
        },
        {
          "comment": "varargs / spread sigils - before the arithmetic '*' and '**', which would otherwise consume them",
          "name": "keyword.operator.varargs.wyrm",
          "match": "(\\*\\*|\\*)(?=[A-Za-z_])"
        },
        {
          "name": "keyword.operator.assignment.wyrm",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.wyrm",
          "match": "\\*\\*|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.wyrm",
          "match": "&|\\||\\^"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.wyrm",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.wyrm",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.wyrm",
          "match": ";"
        },
        {
          "name": "punctuation.section.brace.wyrm",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.bracket.wyrm",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.wyrm",
          "match": "[()]"
        }
      ]
    }
  }
}
